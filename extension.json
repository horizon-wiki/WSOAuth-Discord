{
	"name": "WSOAuth-Discord",
	"version": "1.1.0",
	"author": [ "Hugin" ],
	"url": "https://github.com/horizon-wiki/WSOAuth-Discord",
	"descriptionmsg": "wsoauth-discord-desc",
	"license-name": "MIT",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0",
		"extensions": {
			"WSOAuth": ">= 9.0.0"
		}
	},
	"AutoloadNamespaces": {
		"WSOAuthDiscord\\": "src/"
	},
	"MessagesDirs": {
		"WSOAuthDiscord": [ "i18n" ]
	},
	"ResourceFileModulePaths": {
		"localBasePath": "modules",
		"remoteExtPath": "WSOAuth-Discord/modules"
	},
	"ResourceModules": {
		"ext.wsoauthDiscord.sameWindow": {
			"packageFiles": [
				"ext.wsoauthDiscord.sameWindow.js",
				{
					"name": "config.json",
					"config": [ "WSOAuthDiscordLoginButtonSelector" ]
				}
			],
			"dependencies": [ "mediawiki.util" ]
		}
	},
	"Hooks": {
		"WSOAuthGetAuthProviders": "WSOAuthDiscord\\Hooks::onWSOAuthGetAuthProviders",
		"SpecialPageBeforeExecute": "WSOAuthDiscord\\Hooks::onSpecialPageBeforeExecute",
		"BeforePageDisplay": "WSOAuthDiscord\\Hooks::onBeforePageDisplay"
	},
	"config": {
		"WSOAuthDiscordSameWindowLogin": {
			"value": false,
			"description": "Log in from the current page in the same window, coming back to it afterwards, instead of through Special:UserLogin's form."
		},
		"WSOAuthDiscordLoginButtonSelector": {
			"value": "",
			"description": "A CSS selector for a login button in the skin that should also log in this way; empty for none."
		}
	},
	"manifest_version": 2
}
